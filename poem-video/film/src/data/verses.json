[
 {
  "verse": 1,
  "start": 1.17,
  "end": 9.11,
  "hemistichs": [
   {
    "text": "هَلْ كُنْتَ مِثْلِيَ يَا جَدَّاهُ تَرْتَجِفُ؟",
    "start": 1.17,
    "end": 5.29
   },
   {
    "text": "لَمَّا تَمَكَّنَ مِنْكَ الوَجْدُ وَالشَّغَفُ",
    "start": 5.29,
    "end": 9.11
   }
  ]
 },
 {
  "verse": 2,
  "start": 9.11,
  "end": 18.01,
  "hemistichs": [
   {
    "text": "هَلْ خَابَ ظَنُّكَ حِيْنَ الشَّمْسِ قَدْ أَفَلَتْ",
    "start": 9.11,
    "end": 13.19
   },
   {
    "text": "بِرَبَّةٍ كَالوَرَى تَأْتِيْ وَتَنْصَرِفُ",
    "start": 13.19,
    "end": 18.01
   }
  ]
 },
 {
  "verse": 3,
  "start": 18.01,
  "end": 26.11,
  "hemistichs": [
   {
    "text": "هَلِ انْتَبَذْتَ مَكَانَاً نَائِيَاً لِتَرَى",
    "start": 18.01,
    "end": 22.87
   },
   {
    "text": "رُوْحَ الحَقِيْقَةِ وَالأَسْرَارِ تَنْكَشِفُ",
    "start": 22.87,
    "end": 26.11
   }
  ]
 },
 {
  "verse": 4,
  "start": 26.11,
  "end": 34.27,
  "hemistichs": [
   {
    "text": "وَقَفْتُ مِثْلَكَ بين البينِ مُضْطَرِبَاً",
    "start": 26.11,
    "end": 30.27
   },
   {
    "text": "أَنْ أَدَّعِي العِلْمَ أَمْ بِالعَجْزِ أَعْتَرِفُ",
    "start": 30.27,
    "end": 34.27
   }
  ]
 },
 {
  "verse": 5,
  "start": 34.27,
  "end": 43.07,
  "hemistichs": [
   {
    "text": "وَصِرْتُ أَسْمَعُ أَصْوَاتَاً وَأَفْهَمُهَا",
    "start": 34.27,
    "end": 38.95
   },
   {
    "text": "وَفِيْ الخَيَالَاتِ سِرٌ بَاتَ يَنْكَشِفُ",
    "start": 38.95,
    "end": 43.07
   }
  ]
 },
 {
  "verse": 6,
  "start": 43.07,
  "end": 52.71,
  "hemistichs": [
   {
    "text": "بِأَنَّ جِلْدِيَ تَارِيْخٌ وَأَنْسِجَتِي",
    "start": 43.07,
    "end": 48.43
   },
   {
    "text": "مُذْ أَوَّلِ الدَّهْرِ لِلْقَوْمِ الأُلَى صُحُفُ",
    "start": 48.43,
    "end": 52.71
   }
  ]
 },
 {
  "verse": 7,
  "start": 52.71,
  "end": 60.83,
  "hemistichs": [
   {
    "text": "وَأَنَّنِي الآكِلُ المَأْكُوْلُ مُذْ وَطَأَتْ",
    "start": 52.71,
    "end": 56.95
   },
   {
    "text": "أَقْدَامُ آدَمَ حَتَّى تَسْقُطَ الكِسَفُ",
    "start": 56.95,
    "end": 60.83
   }
  ]
 },
 {
  "verse": 8,
  "start": 60.83,
  "end": 69.45,
  "hemistichs": [
   {
    "text": "مَنْ مَسَّهُ الضُّرُ أَوْ مَنْ مَسَّهُ تَرَفُ",
    "start": 60.83,
    "end": 64.87
   },
   {
    "text": "هَذَا التُّرَابُ وُجُوهٌ فَوْقَهَا نَقِفُ",
    "start": 64.87,
    "end": 69.45
   }
  ]
 },
 {
  "verse": 9,
  "start": 69.45,
  "end": 78.53,
  "hemistichs": [
   {
    "text": "كُنْهُ المِيَاهِ الَّتِي نَظْمَا وَتَشْرَبُهَا",
    "start": 69.45,
    "end": 74.15
   },
   {
    "text": "أَشْلَاءُ أَهْلٍ لَنَا قَدْ نَالَهَا تَلَفُ",
    "start": 74.15,
    "end": 78.53
   }
  ]
 },
 {
  "verse": 10,
  "start": 78.53,
  "end": 87.89,
  "hemistichs": [
   {
    "text": "هَذَا الغُبَارُ بَقَايَا جِلْدِ مَنْ ذَهَبُوا",
    "start": 78.53,
    "end": 84.11
   },
   {
    "text": "إِلَى الفَنَاءِ لِيَأْتِيْ بَعْدَهُمْ سَلَفُ",
    "start": 84.11,
    "end": 87.89
   }
  ]
 },
 {
  "verse": 11,
  "start": 87.89,
  "end": 96.55,
  "hemistichs": [
   {
    "text": "هُنَا بَقَايَا لِخَدٍ تِلْكَ جُمْجُمَةٌ",
    "start": 87.89,
    "end": 92.87
   },
   {
    "text": "ذَاك المُهَشَّمُ مِنْ أَطْرَافِهِ كَتِفُ",
    "start": 92.87,
    "end": 96.55
   }
  ]
 },
 {
  "verse": 12,
  "start": 96.55,
  "end": 105.43,
  "hemistichs": [
   {
    "text": "أَمْشِي مَعَ النَّهْرِ، وَالأَمْوَاجُ تُخْبِرُنِي",
    "start": 96.55,
    "end": 101.43
   },
   {
    "text": "أَنَّ الحُقُوْلَ لِقَطَّافِيْنَ قَدْ قُطِفُوا",
    "start": 101.43,
    "end": 105.43
   }
  ]
 },
 {
  "verse": 13,
  "start": 105.43,
  "end": 114.67,
  "hemistichs": [
   {
    "text": "حَيْثُ الجِرَارُ عُيُوْنٌ ذَابَ بُؤْبُؤُهَا",
    "start": 105.43,
    "end": 109.99
   },
   {
    "text": "تَكَادُ تَهْتِفُ لَوْلَا أَنَّهَا خَزَفُ",
    "start": 109.99,
    "end": 114.67
   }
  ]
 },
 {
  "verse": 14,
  "start": 114.67,
  "end": 123.57,
  "hemistichs": [
   {
    "text": "أُسْقِي اليَمَامَاتِ دَمْعَاً سَالَ مِنْ حَدَقٍ",
    "start": 114.67,
    "end": 119.19
   },
   {
    "text": "خَلْفَ الجُنُوْدِ لِغَادَاتٍ بِهَا شُغُفُ",
    "start": 119.19,
    "end": 123.57
   }
  ]
 },
 {
  "verse": 15,
  "start": 123.57,
  "end": 132.81,
  "hemistichs": [
   {
    "text": "ثَوْبِيْ القَتِيْلُ بِهِ وَالقَاتِلُ اجْتَمَعَا",
    "start": 123.57,
    "end": 128.77
   },
   {
    "text": "حَيْثُ النَّقَائِضُ وَالأَضْدَادُ تَأْتَلِفُ",
    "start": 128.77,
    "end": 132.81
   }
  ]
 },
 {
  "verse": 16,
  "start": 132.81,
  "end": 142.15,
  "hemistichs": [
   {
    "text": "وَيْحِيْ أَدُوْسُ عَلَى أَهْلِيْ بِلَا خَجَلٍ",
    "start": 132.81,
    "end": 138.23
   },
   {
    "text": "إِذَا مَشَيْتُ وَبِالأَسْلَافِ أَلْتَحِفُ",
    "start": 138.23,
    "end": 142.15
   }
  ]
 },
 {
  "verse": 17,
  "start": 142.15,
  "end": 151.37,
  "hemistichs": [
   {
    "text": "الرَّاحِلُوْنَ وَإِنْ شَادَ البُنَاةُ لَهُمْ",
    "start": 142.15,
    "end": 146.73
   },
   {
    "text": "فِيْ رَبْعِهَا غُرَفَاً مِنْ فَوْقِهَا غُرَفُ",
    "start": 146.73,
    "end": 151.37
   }
  ]
 },
 {
  "verse": 18,
  "start": 151.37,
  "end": 159.53,
  "hemistichs": [
   {
    "text": "مَنْ عَلَّمَ النَّهْرَ أَنْ يَجْرِيْ إِلَى أَزَلٍ؟",
    "start": 151.37,
    "end": 155.71
   },
   {
    "text": "مَنْ يَأْمُرُ اللَّيْلَ أَنْ يَنْأَى وَيَزْدَلِفُ؟",
    "start": 155.71,
    "end": 159.53
   }
  ]
 },
 {
  "verse": 19,
  "start": 159.53,
  "end": 168.69,
  "hemistichs": [
   {
    "text": "أَيَطْلَعُ الطَّلْعُ مِنْ أَكْمَامِهِ زُمَرَاً",
    "start": 159.53,
    "end": 163.73
   },
   {
    "text": "بِأَلْفِ لَوْنٍ وَشَكْلٍ كُلُّهَا صُدَفُ؟",
    "start": 163.73,
    "end": 168.69
   }
  ]
 },
 {
  "verse": 20,
  "start": 168.69,
  "end": 177.25,
  "hemistichs": [
   {
    "text": "هَذَا النَّخِيْلُ نَبِيَّاتٌ حَمَلْنَ لَنَا",
    "start": 168.69,
    "end": 173.89
   },
   {
    "text": "رَسَائِلَ اللهِ يَتْلُو آيَهَا السَّعَفُ",
    "start": 173.89,
    "end": 177.25
   }
  ]
 },
 {
  "verse": 21,
  "start": 177.25,
  "end": 187.63,
  "hemistichs": [
   {
    "text": "يَا كُلَّ مَنْ مَاتَ.. يَا آتٍ لِعَالَمِنَا",
    "start": 177.25,
    "end": 182.67
   },
   {
    "text": "أَنْتَ الجَمِيْعُ وَمِنْكَ الكُلُّ مُقْتَطَفُ",
    "start": 182.67,
    "end": 187.63
   }
  ]
 }
]